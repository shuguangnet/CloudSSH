# The browser and MCP client must use this exact origin.
BASE_URL=http://localhost:8787
PORT=8787
# Docker port binding. For a remote reverse proxy use 0.0.0.0 intentionally.
BIND_ADDRESS=127.0.0.1
# Use HTTPS for remote access; opt-in only for a trusted private HTTP network.
ALLOW_INSECURE_HTTP=false
IDLE_TIMEOUT=30m
# Optional: GitHub OAuth instead of the generated administrator login.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USER_IDS=
